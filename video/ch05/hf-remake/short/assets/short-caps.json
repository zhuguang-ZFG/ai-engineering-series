[
  {
    "start": 3.3,
    "end": 5.068,
    "text": "改了 settings."
  },
  {
    "start": 5.068,
    "end": 5.539,
    "text": "json，"
  },
  {
    "start": 5.539,
    "end": 8.014,
    "text": "重启——还是老样子。"
  },
  {
    "start": 7.964,
    "end": 9.36,
    "text": "你没改错值，"
  },
  {
    "start": 9.36,
    "end": 10.756,
    "text": "你改错了层。"
  },
  {
    "start": 10.756,
    "end": 13.28,
    "text": "配置不是一个文件，"
  },
  {
    "start": 13.28,
    "end": 15.49,
    "text": "是六层岩：插件、"
  },
  {
    "start": 15.49,
    "end": 16.121,
    "text": "用户、"
  },
  {
    "start": 16.121,
    "end": 16.752,
    "text": "项目、"
  },
  {
    "start": 16.752,
    "end": 17.383,
    "text": "本地、"
  },
  {
    "start": 17.383,
    "end": 17.699,
    "text": "CLI、"
  },
  {
    "start": 17.699,
    "end": 18.33,
    "text": "企业，"
  },
  {
    "start": 18.33,
    "end": 19.908,
    "text": "越往上越大。"
  },
  {
    "start": 19.908,
    "end": 21.895,
    "text": "盖住不等于删掉，"
  },
  {
    "start": 21.895,
    "end": 24.45,
    "text": "所以挑层比改值要紧。"
  },
  {
    "start": 24.45,
    "end": 28.506,
    "text": "猜一猜：权限数组会被上层覆盖掉吗？"
  },
  {
    "start": 28.506,
    "end": 29.631,
    "text": "不会。"
  },
  {
    "start": 29.631,
    "end": 31.373,
    "text": "数组只拼接去重，"
  },
  {
    "start": 31.373,
    "end": 32.368,
    "text": "像钥匙圈，"
  },
  {
    "start": 32.368,
    "end": 33.862,
    "text": "每层挂自己的，"
  },
  {
    "start": 33.862,
    "end": 35.853,
    "text": "谁也摘不掉别人的。"
  },
  {
    "start": 35.853,
    "end": 38.672,
    "text": "要撤销得用 deny 明说。"
  },
  {
    "start": 38.672,
    "end": 41.217,
    "text": "最后一刀：六层里有一层，"
  },
  {
    "start": 41.217,
    "end": 44.456,
    "text": "安全上系统根本不看它——项目那层，"
  },
  {
    "start": 44.456,
    "end": 46.769,
    "text": "因为它来自别人的仓库。"
  },
  {
    "start": 46.769,
    "end": 50.881,
    "text": "完整版在 B 站合集「驭者·Agent Harness」。"
  }
