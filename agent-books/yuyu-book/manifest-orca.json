    "orca-front": {
      "question": {
        "zh": "为什么先对齐程序，再谈并行？"
      },
      "deliverable": {
        "zh": "选一条阅读路线，分清实测输出、源码与文档三种证据。"
      },
      "boundary": {
        "zh": "源码固定到公开提交 c354ab3；发布版实测只覆盖 Windows 1.4.269。"
      },
      "sources": [
        "orca-repo",
        "orca-app"
      ],
      "plain": {
        "zh": "这本书的入口：桌面应用、命令行、运行时是三个程序，先认清楚再往下走。"
      },
      "plain_evidence": [
        "orca-front.b-opening"
      ]
    },
    "orca-ch01": {
      "question": {
        "zh": "怎样确认终端里那个 orca 就是你装的那一份？"
      },
      "deliverable": {
        "zh": "读出 app.asar 里的版本，跑通两条自检命令，记下四个状态字段。"
      },
      "boundary": {
        "zh": "只实测 Windows 安装目录；orca serve 与 macOS、Linux 结构未验证。"
      },
      "sources": [
        "orca-repo",
        "orca-app"
      ],
      "plain": {
        "zh": "三个版本号对不上是正常的：读 app.asar 判断你手上这份，别读仓库的 package.json。"
      },
      "plain_evidence": [
        "orca-ch01.b-opening"
      ]
    },
    "orca-ch02": {
      "question": {
        "zh": "一次开工作树的请求，中间经过哪几层登记？"
      },
      "deliverable": {
        "zh": "用四条只读命令对齐 git 层与 Orca 层，说出每个字段挂在哪一层。"
      },
      "boundary": {
        "zh": "create 与 rm 的闭环未在本机执行；参数面以本机帮助文本为准，与钉住提交的差异已写明。"
      },
      "sources": [
        "orca-repo",
        "orca-app"
      ],
      "plain": {
        "zh": "请求由 Orca 协调、git 物化目录；两层各留记录，各有一条只读命令可以核对。"
      },
      "plain_evidence": [
        "orca-ch02.b-opening"
      ]
    },
    "orca-apxa": {
      "question": {
        "zh": "命令与运行目录怎么对上？"
      },
      "deliverable": {
        "zh": "把安装根、命令组与自检命令排成一张表。"
      },
      "boundary": {
        "zh": "只实测 Windows；其余分组只读到帮助文本。"
      },
      "sources": [
        "orca-app"
      ],
      "plain": {
        "zh": "把安装根、命令组与自检命令排成一张表。"
