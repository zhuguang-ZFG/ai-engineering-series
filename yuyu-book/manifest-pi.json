      "question": {
        "zh": "CI 里怎么判断 Pi 成功？"
      },
      "deliverable": {
        "zh": "能写退出码 + stderr + agent_settled 的检查。"
      },
      "boundary": {
        "zh": "别吞 stderr。"
      },
      "plain": {
        "zh": "退出码、stderr、agent_settled，三者一起看。"
      },
      "plain_evidence": [
        "pi/ch21.md:12"
      ]
    },
