  "guides": {
    "pi-front": {
      "question": {
        "zh": "为什么再写一本 Pi 的书？"
      },
      "deliverable": {
        "zh": "知道三册的分工与本册的试章范围。"
      },
      "boundary": {
        "zh": "不把未验证写成已验证。"
      },
      "plain": {
        "zh": "为什么再写一本：Pi 的取舍与本书范围。"
      },
      "plain_evidence": [
        "pi/00-前言.md:3"
      ]
    },
    "pi-ch01": {
      "question": {
        "zh": "Pi 砍掉了什么，为什么这是卖点？"
      },
      "deliverable": {
        "zh": "能用 4 个默认工具与无内置权限系统解释它的边界。"
      },
      "boundary": {
        "zh": "不把极简误解成有隐形护栏。"
      },
      "plain": {
        "zh": "Pi 的卖点是可做小，不是功能多。"
      },
      "plain_evidence": [
        "pi/ch01.md:3"
      ]
    },
    "pi-ch02": {
      "question": {
        "zh": "怎么装、装完怎么确认、第一圈在哪跑？"
      },
      "deliverable": {
        "zh": "能从版本、Node、目录三处确认环境。"
      },
      "boundary": {
        "zh": "先 cd 再启动，别在家目录跑。"
      },
      "plain": {
        "zh": "装好、确认版本、在正确目录跑第一圈。"
      },
      "plain_evidence": [
        "pi/ch02.md:3"
      ]
    },
    "pi-ch03": {
      "question": {
        "zh": "模型、provider、凭据怎么串起来？"
      },
      "deliverable": {
        "zh": "能按凭据优先级排查‘模型找不到’。"
      },
      "boundary": {
        "zh": "不要把模型目录当成可用性证明。"
      },
      "plain": {
        "zh": "模型、provider、凭据三层，缺一层就找不到。"
      },
      "plain_evidence": [
        "pi/ch03.md:1"
      ]
    },
    "pi-ch04": {
      "question": {
        "zh": "运行中插话，消息什么时候生效？"
      },
      "deliverable": {
        "zh": "能区分 steering、follow-up 与 abort。"
      },
      "boundary": {
        "zh": "Windows Terminal 会截走部分 Alt 键。"
      },
      "plain": {
        "zh": "输入分发送与排队，选错只会让补充晚到。"
      },
      "plain_evidence": [
        "pi/ch04.md:3"
      ]
    },
    "pi-ch05": {
      "question": {
        "zh": "会话为什么是树，回退回退的是什么？"
      },
      "deliverable": {
        "zh": "能解释 --continue 与 --resume 的目录差异。"
      },
      "boundary": {
        "zh": "不要手改 parentId 合并分支。"
      },
      "plain": {
        "zh": "回退不是覆盖，旧分支仍在树里。"
      },
      "plain_evidence": [
        "pi/ch05.md:1"
      ]
    },
    "pi-ch06": {
      "question": {
        "zh": "模型每次看到什么？"
      },
      "deliverable": {
        "zh": "能证明 AGENTS.md 进了 project_context。"
      },
      "boundary": {
        "zh": "上下文文件不受项目信任门禁。"
      },
      "plain": {
        "zh": "位置决定作用域，信任不保护上下文文件。"
      },
      "plain_evidence": [
        "pi/ch06.md:1"
      ]
    },
    "pi-ch07": {
      "question": {
        "zh": "压缩和分支摘要各解决什么问题？"
      },
      "deliverable": {
        "zh": "能说出阈值公式与 firstKeptEntryId 的作用。"
      },
      "boundary": {
        "zh": "压缩不删原始条目。"
      },
      "plain": {
        "zh": "摘要换窗口，原始条目不会被删。"
      },
      "plain_evidence": [
        "pi/ch07.md:1"
      ]
    },
    "pi-ch08": {
      "question": {
        "zh": "文本、JSON、RPC 各自适合什么？"
      },
      "deliverable": {
        "zh": "能按 agent_settled 判断一次 run 真的结束。"
      },
      "boundary": {
        "zh": "不要把 print 输出当 JSON。"
      },
      "plain": {
        "zh": "文本、事件流、双向控制，三种出口别混用。"
      },
      "plain_evidence": [
        "pi/ch08.md:10"
      ]
    },
    "pi-ch09": {
      "question": {
        "zh": "一次 turn 里发生了什么？"
      },
      "deliverable": {
        "zh": "能列出 turn 的五段工具生命周期。"
      },
      "boundary": {
        "zh": "agent_end 不是最终结束。"
      },
      "plain": {
        "zh": "一个 turn 是一次回复加它的工具结果。"
      },
      "plain_evidence": [
        "pi/ch09.md:3"
      ]
    },
    "pi-ch10": {
      "question": {
        "zh": "模型层统一了什么？"
      },
      "deliverable": {
        "zh": "能看懂目录六列与 thinking 夹取。"
      },
      "boundary": {
        "zh": "不要把目录能力当 provider 承诺。"
      },
      "plain": {
        "zh": "统一消息与事件，不统一 provider 的私有字段。"
      },
      "plain_evidence": [
        "pi/ch10.md:1"
      ]
    },
    "pi-ch11": {
      "question": {
        "zh": "工具怎么声明、执行、回喂？"
      },
      "deliverable": {
        "zh": "能用 --tools 的两种语法并避免混用。"
      },
      "boundary": {
        "zh": "默认只有四个工具。"
      },
      "plain": {
        "zh": "默认四个工具，其余按需声明。"
      },
      "plain_evidence": [
        "pi/ch11.md:1"
      ]
    },
    "pi-ch12": {
      "question": {
        "zh": "会话文件里存了什么，怎么恢复？"
      },
      "deliverable": {
        "zh": "能按 version 与 entry type 读 JSONL。"
      },
      "boundary": {
        "zh": "context_edit 只改未来请求。"
      },
      "plain": {
        "zh": "会话是公开的 JSONL 契约，按版本读。"
      },
      "plain_evidence": [
        "pi/ch12.md:1"
      ]
    },
    "pi-ch13": {
      "question": {
        "zh": "事件怎么变成终端画面？"
      },
      "deliverable": {
        "zh": "能解释差分渲染、主题与 TUI 模式。"
      },
      "boundary": {
        "zh": "扩展 UI 不要直接 console.log。"
      },
      "plain": {
        "zh": "事件到组件到差分渲染，主题跟着终端。"
      },
      "plain_evidence": [
        "pi/ch13.md:3"
      ]
    },
    "pi-ch14": {
      "question": {
        "zh": "扩展从哪加载、生命周期怎么走？"
      },
      "deliverable": {
        "zh": "能用 -e 加载并验证 session_start。"
      },
      "boundary": {
        "zh": "扩展与 Pi 同权限。"
      },
      "plain": {
        "zh": "扩展在进程内，信任只管加载。"
      },
      "plain_evidence": [
        "pi/ch14.md:1"
      ]
    },
    "pi-ch15": {
      "question": {
        "zh": "怎么给 Pi 加工具、命令与 UI？"
      },
      "deliverable": {
        "zh": "能写一个 registerTool 并让模型调用。"
      },
      "boundary": {
        "zh": "注册与激活分开看，默认 direct 工具通常会激活。"
      },
      "plain": {
        "zh": "注册工具、命令与 UI，让 Pi 长出你要的手。"
      },
      "plain_evidence": [
        "pi/ch15.md:1"
      ]
    },
    "pi-ch16": {
      "question": {
        "zh": "技能怎么省上下文？"
      },
      "deliverable": {
        "zh": "能解释描述常驻、全文按需读。"
      },
      "boundary": {
        "zh": "没有 read 工具时技能不会被广告。"
      },
      "plain": {
        "zh": "技能只广告描述，全文按需读。"
      },
      "plain_evidence": [
        "pi/ch16.md:1"
      ]
    },
    "pi-ch17": {
      "question": {
        "zh": "模板与主题各解决什么重复劳动？"
      },
      "deliverable": {
        "zh": "能写参数化模板并切换主题。"
      },
      "boundary": {
        "zh": "模板展开入口与 CLI 位置参数不同。"
      },
      "plain": {
        "zh": "模板扩展命令，主题扩展外观。"
      },
      "plain_evidence": [
        "pi/ch17.md:1"
      ]
    },
    "pi-ch18": {
      "question": {
        "zh": "插件装进 Pi 后改了什么，怎样用 pi-purge 验证？"
      },
      "deliverable": {
        "zh": "能管理包的范围与版本，复现 pi-purge 的三种模式和失败路径。"
      },
      "boundary": {
        "zh": "改系统提示词不等于删历史、撤销工具权限或隔离执行。"
      },
      "plain": {
        "zh": "一个包带走扩展、技能、模板与主题。"
      },
      "plain_evidence": [
        "pi/ch18.md:1"
      ]
    },
    "pi-ch19": {
      "question": {
        "zh": "SDK 与 RPC 的边界在哪？"
      },
      "deliverable": {
        "zh": "能选进程内嵌还是子进程控制。"
      },
      "boundary": {
        "zh": "prompt 成功不代表完成。"
      },
      "plain": {
        "zh": "SDK 进程内嵌，RPC 子进程控制。"
      },
      "plain_evidence": [
        "pi/ch19.md:5"
      ]
    },
    "pi-ch20": {
      "question": {
        "zh": "怎么让 Pi 真正交付一次改动？"
      },
      "deliverable": {
        "zh": "能用验收标准 + diff + 测试复核。"
      },
      "boundary": {
        "zh": "测试通过不等于边界正确。"
      },
      "plain": {
        "zh": "验收标准、diff、测试，一个都不能省。"
      },
      "plain_evidence": [
        "pi/ch20.md:49"
      ]
    },
