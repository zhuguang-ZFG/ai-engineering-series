  "guides": {
    "hermes-front": {
      "question": {
        "zh": "为什么把 Hermes 单独写成一册？"
      },
      "deliverable": {
        "zh": "分清记忆、技能与历史的用途。"
      },
      "boundary": {
        "zh": "本书不把组件实验说成完整宿主实跑。"
      },
      "plain": {
        "zh": "记忆、技能与历史，分别留下不同的经验。"
      },
      "plain_evidence": [
        "hermes-front.b-opening"
      ],
      "sources": [
        "hermes-repo"
      ]
    },
    "hermes-ch01": {
      "question": {
        "zh": "程序与用户数据怎样分开？"
      },
      "deliverable": {
        "zh": "建立独立的实验 home 并记录版本。"
      },
      "boundary": {
        "zh": "改变工作目录不自动切换配置。"
      },
      "plain": {
        "zh": "先分开程序、用户数据和工作目录。"
      },
      "plain_evidence": [
        "hermes-ch01.b-opening"
      ],
      "sources": [
        "hermes-repo",
        "hermes-config"
      ]
    },
    "hermes-ch02": {
      "question": {
        "zh": "一次任务怎样走到工具调用？"
      },
      "deliverable": {
        "zh": "顺着输入、工具结果和后续请求追踪循环。"
      },
      "boundary": {
        "zh": "schema 合法不等于业务动作正确。"
      },
      "plain": {
        "zh": "模型提出动作，宿主执行并把结果送回来。"
      },
      "plain_evidence": [
        "hermes-ch02.b-opening"
      ],
      "sources": [
        "hermes-loop",
        "hermes-registry"
      ]
    },
    "hermes-ch03": {
      "question": {
        "zh": "恢复会话时实际恢复了什么？"
      },
      "deliverable": {
        "zh": "区分消息记录、压缩内容和实际副作用。"
      },
      "boundary": {
        "zh": "重新打开记录不会撤销文件变化。"
      },
      "plain": {
        "zh": "会话保存过程，恢复时还要核对实际产物。"
      },
      "plain_evidence": [
        "hermes-ch03.b-opening"
      ],
      "sources": [
        "hermes-state",
        "hermes-loop",
        "hermes-compression"
      ]
    },
    "hermes-ch04": {
      "question": {
        "zh": "记忆保存后什么时候进入提示？"
      },
      "deliverable": {
        "zh": "运行 17 项组件实验，解释快照、审批、批处理与写入异常。"
      },
      "boundary": {
        "zh": "当前快照与磁盘新内容可能不同。"
      },
      "plain": {
        "zh": "长期记忆要同时看文件和当前提示快照。"
      },
      "plain_evidence": [
        "hermes-ch04.b-opening"
      ],
      "sources": [
        "hermes-memory",
        "hermes-memory-tool",
        "hermes-atomic"
      ]
    },
