      "deliverable": {
        "zh": "用失败样本修订技能并保留反例。"
      },
      "boundary": {
        "zh": "单次例外不应变成所有任务的规则。"
      },
      "plain": {
        "zh": "把失败变成有条件、可重做的方法修订。"
