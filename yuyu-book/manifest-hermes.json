  "guides": {
    "hermes-front": {
      "question": {
        "zh": "昨天已经交代过的项目要求，为什么今天还要再说？"
      },
      "deliverable": {
        "zh": "认识 Aurora 项目和随书实验的三种运行范围。"
      },
      "boundary": {
        "zh": "本书运行了组件与本地文件流程，完整 Hermes 宿主尚未验证。"
      },
      "plain": {
        "zh": "一句项目事实、一套操作方法和一段旧讨论，在 Hermes 中有不同的保存方式。"
      },
      "plain_evidence": [
        "hermes-front.b-opening"
      ],
      "sources": [
        "hermes-repo"
      ]
    },
    "hermes-ch01": {
      "question": {
        "zh": "怎样试用 Hermes，又不影响日常配置？"
      },
      "deliverable": {
        "zh": "建立独立 home，初始化 Aurora，并读懂第一份检查报告。"
      },
      "boundary": {
        "zh": "切换工作目录不会自动切换用户配置。"
      },
      "plain": {
        "zh": "先确定程序、用户数据和 Aurora 文件各放在哪里。"
      },
      "plain_evidence": [
        "hermes-ch01.b-opening"
      ],
      "sources": [
        "hermes-repo",
        "hermes-config"
      ]
    },
    "hermes-ch02": {
      "question": {
        "zh": "“检查 Aurora”怎样变成一次具体工具调用？"
      },
      "deliverable": {
        "zh": "追踪工具名、参数、退出码与送回模型的结果。"
      },
      "boundary": {
        "zh": "参数符合 schema，仍可能不符合业务规则。"
      },
      "plain": {
        "zh": "模型提出读取或执行请求，Hermes 调用工具，再把结果送回对话。"
      },
      "plain_evidence": [
        "hermes-ch02.b-opening"
      ],
      "sources": [
        "hermes-loop",
        "hermes-registry"
      ]
    },
    "hermes-ch03": {
      "question": {
        "zh": "会话恢复了，文件已经改名，接下来怎么办？"
      },
      "deliverable": {
        "zh": "比较旧报告与当前文件，修复 Aurora 的索引链接。"
      },
      "boundary": {
        "zh": "重新打开会话记录不会撤销文件变化。"
      },
      "plain": {
        "zh": "恢复对话后重新读取项目，判断旧计划还适不适用。"
      },
      "plain_evidence": [
        "hermes-ch03.b-opening"
      ],
      "sources": [
        "hermes-state",
        "hermes-loop",
        "hermes-compression"
      ]
    },
    "hermes-ch04": {
      "question": {
        "zh": "记忆保存成功后，为什么系统提示没有变化？"
      },
      "deliverable": {
        "zh": "运行 17 项组件实验，查看快照、审批、批处理与写入异常。"
      },
      "boundary": {
        "zh": "当前提示快照可能仍保留加载时的旧内容。"
      },
      "plain": {
        "zh": "把磁盘、对象中的条目与提示快照放在一起看，写入和加载的区别就清楚了。"
      },
      "plain_evidence": [
        "hermes-ch04.b-opening"
      ],
      "sources": [
        "hermes-memory",
        "hermes-memory-tool",
        "hermes-atomic"
      ]
    },
    "hermes-ch05": {
      "question": {
        "zh": "怎样把 Aurora 检查步骤写成可复用的技能？"
      },
      "deliverable": {
        "zh": "组织技能正文与配套脚本，核对宿主读到的实际文件。"
      },
      "boundary": {
        "zh": "读取技能正文不会自动执行其中的脚本。"
      },
      "plain": {
        "zh": "先发现技能的用途，需要时再读取方法与配套材料。"
      },
      "plain_evidence": [
        "hermes-ch05.b-opening"
      ],
      "sources": [
        "hermes-skills",
        "hermes-skills-tool"
      ]
    },
    "hermes-ch06": {
      "question": {
        "zh": "示例 URL 漏检后，究竟要改哪一份文件？"
      },
      "deliverable": {
        "zh": "用失败样本和反例修订技能，区分规则、程序与结果解释。"
      },
      "boundary": {
        "zh": "一次任务的例外未必适合作为所有项目的规则。"
      },
      "plain": {
        "zh": "将漏检样本留住，修改后再试一次，也看看有没有误伤相邻情况。"
      },
      "plain_evidence": [
        "hermes-ch06.b-opening"
      ],
      "sources": [
        "hermes-skill-manage"
      ]
    },
    "hermes-ch07": {
      "question": {
        "zh": "上次为什么排除归档，后来又是谁改了范围？"
      },
      "deliverable": {
        "zh": "从检索片段继续读取邻近消息，核对时间与决定来源。"
      },
      "boundary": {
        "zh": "搜索结果只展示部分记录和内容窗口。"
      },
      "plain": {
        "zh": "历史可以解释旧决定，当前任务仍需读取现在的规则。"
      },
      "plain_evidence": [
        "hermes-ch07.b-opening"
      ],
      "sources": [
        "hermes-search",
        "hermes-state"
      ]
    },
    "hermes-ch08": {
      "question": {
        "zh": "旧记忆与新规则冲突时，怎样准确修订？"
      },
      "deliverable": {
        "zh": "定位唯一条目，比较删除前后的文件、快照和历史副本。"
      },
      "boundary": {
        "zh": "删除条目不会同时抹去历史、备份与当前上下文。"
      },
      "plain": {
        "zh": "先分辨规则变化与临时例外，再决定更新或删除哪条记忆。"
      },
      "plain_evidence": [
        "hermes-ch08.b-opening"
      ],
      "sources": [
        "hermes-memory",
        "hermes-memory-tool"
      ]
    },
    "hermes-ch09": {
      "question": {
        "zh": "资料清单工具怎样从插件目录进入一次调用？"
      },
      "deliverable": {
        "zh": "沿加载时序读源码，运行完整插件及 9 项离线测试。"
      },
      "boundary": {
        "zh": "离线处理器测试未加载真实 PluginManager。"
      },
      "plain": {
        "zh": "从 register 接上工具，再追踪注册句柄、配置来源和卸载清理。"
      },
      "plain_evidence": [
        "hermes-ch09.b-opening"
      ],
      "sources": [
        "hermes-plugins",
        "hermes-discovery",
        "hermes-registry",
        "hermes-plugin-manifest"
      ]
    },
    "hermes-ch10": {
      "question": {
        "zh": "外部索引服务超时了，能直接再调用一次吗？"
      },
      "deliverable": {
        "zh": "追踪连接、工具发现、调用与关闭，设计断线实验。"
      },
      "boundary": {
        "zh": "写操作重试可能重复已经完成的业务动作。"
      },
      "plain": {
        "zh": "MCP 调用多了连接和服务端状态，排错时要知道请求停在哪一步。"
      },
      "plain_evidence": [
        "hermes-ch10.b-opening"
      ],
      "sources": [
        "hermes-mcp"
      ]
    },
    "hermes-ch11": {
      "question": {
        "zh": "每天检查的任务已经保存，为什么还没收到结果？"
      },
      "deliverable": {
        "zh": "分别查看到期、领取、执行和投递记录。"
      },
      "boundary": {
        "zh": "一次成功不能保证以后遇到故障时也恰好执行一次。"
      },
      "plain": {
        "zh": "任务存在、报告生成与消息送达，发生在不同阶段。"
      },
      "plain_evidence": [
        "hermes-ch11.b-opening"
      ],
      "sources": [
        "hermes-cron",
        "hermes-jobs"
      ]
    },
    "hermes-ch12": {
      "question": {
        "zh": "同名用户从不同群组提问，会进入同一会话吗？"
      },
      "deliverable": {
        "zh": "核对平台、账户、聊天位置、线程与 profile 的路由。"
      },
      "boundary": {
        "zh": "显示名称可能重复或改变，不能替代稳定身份。"
      },
      "plain": {
        "zh": "按消息来源找到会话，再将完成的结果送回原来的任务。"
      },
      "plain_evidence": [
