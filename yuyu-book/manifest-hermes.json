      "deliverable": {
        "zh": "组织一份可发现、可阅读的技能。"
      },
      "boundary": {
        "zh": "技能中的脚本不因被阅读就自动执行。"
      },
      "plain": {
        "zh": "技能把可复用方法与配套材料放在一起。"
