  "guides": {
    "deepseek-front": {
      "question": {
        "zh": "为什么研究代理内部的组合方式？"
      },
      "deliverable": {
        "zh": "认识本册源码范围与组件实验。"
      },
      "boundary": {
        "zh": "完整应用与真实模型未实跑。"
      },
      "plain": {
        "zh": "想替换代理的零件，先弄清它的职责和离开后的清理责任。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-front.b-opening"
      ]
    },
    "deepseek-ch01": {
      "question": {
        "zh": "第一次启动时，配置来自哪里？"
      },
      "deliverable": {
        "zh": "区分安装、工作目录和配置层。"
      },
      "boundary": {
        "zh": "完整 dsh 启动命令是复现指引。"
      },
      "plain": {
        "zh": "安装目录、工作目录和配置目录承担不同职责。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch01.b-opening"
      ]
    },
    "deepseek-ch02": {
      "question": {
        "zh": "依赖还没到齐时，插件会怎样？"
      },
      "deliverable": {
        "zh": "解释服务等待、激活和替换。"
      },
      "boundary": {
        "zh": "服务隔离不等于操作系统沙箱。"
      },
      "plain": {
        "zh": "声明依赖后，服务的出现与消失都会影响插件。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch02.b-opening"
      ]
    },
    "deepseek-ch03": {
      "question": {
        "zh": "卸载插件后，还会留下哪些工作？"
      },
      "deliverable": {
        "zh": "理解 effect、父子所有权和异步清理。"
      },
      "boundary": {
        "zh": "资源清理不会回滚任意外部副作用。"
      },
      "plain": {
        "zh": "把监听器和连接交给拥有它们的插件管理，才能可靠地再次加载。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch03.b-opening"
      ]
    },
    "deepseek-ch04": {
      "question": {
        "zh": "不同阶段的失败应该怎样恢复？"
      },
      "deliverable": {
        "zh": "区分缺依赖、初始化失败和事件错误。"
      },
      "boundary": {
        "zh": "配置行为以固定快照为准。"
      },
      "plain": {
        "zh": "先分清失败发生在哪一层，再选择恢复方式。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch04.b-opening"
      ]
    },
    "deepseek-ch05": {
      "question": {
        "zh": "替换循环需要保留哪些公共行为？"
      },
      "deliverable": {
        "zh": "辨认工厂、句柄、发布和清理契约。"
      },
      "boundary": {
        "zh": "替代驱动是设计练习，未做完整集成。"
      },
      "plain": {
        "zh": "公共 Agent 接口与默认循环分开，替代驱动仍须承担原有契约。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch05.b-opening"
      ]
    },
    "deepseek-ch06": {
      "question": {
        "zh": "一轮任务为什么会包含多次请求？"
      },
      "deliverable": {
        "zh": "读懂 Turn、Step、inbox 和取消边界。"
      },
      "boundary": {
        "zh": "事件顺序来自源码契约。"
      },
      "plain": {
        "zh": "Turn 表达用户任务，Step 表达一次模型请求及其工具处理。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch06.b-opening"
      ]
    },
    "deepseek-ch07": {
      "question": {
        "zh": "恢复时以哪一份记录为准？"
      },
      "deliverable": {
        "zh": "区分事件日志、投影与模型历史。"
      },
      "boundary": {
        "zh": "没有运行真实存储崩溃恢复。"
      },
      "plain": {
        "zh": "会话日志保存事实，模型历史从这些事实中投影出来。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch07.b-opening"
      ]
    },
    "deepseek-ch08": {
      "question": {
        "zh": "稳定指令和动态上下文怎样分开？"
      },
      "deliverable": {
        "zh": "理解片段排序、complete 与撤销。"
      },
      "boundary": {
        "zh": "没有向真实模型发送提示词。"
      },
      "plain": {
        "zh": "固定指令和每次请求变化的上下文需要分开组装。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch08.b-opening"
      ]
    },
    "deepseek-ch09": {
      "question": {
        "zh": "流式响应如何变成可靠的循环输入？"
      },
      "deliverable": {
        "zh": "辨认增量、工具参数、完成与取消。"
      },
      "boundary": {
        "zh": "未验证外部提供者的兼容性。"
      },
      "plain": {
        "zh": "流式协议还要表达工具、结束与取消，只有文本增量不够。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch09.b-opening"
      ]
    },
    "deepseek-ch10": {
      "question": {
        "zh": "模型提出工具调用后经过哪些步骤？"
      },
      "deliverable": {
        "zh": "读懂 schema、策略和结果呈现。"
      },
      "boundary": {
        "zh": "教学工具未在完整宿主集成实跑。"
      },
      "plain": {
        "zh": "参数校验、权限判断、执行和结果规范化共同构成工具管线。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch10.b-opening"
      ]
    },
    "deepseek-ch11": {
      "question": {
        "zh": "中间件什么时候应该调用 next？"
      },
      "deliverable": {
        "zh": "辨认事件模式、委派、短路和返回链。"
      },
      "boundary": {
        "zh": "实跑限定为 Cordis 组件事件。"
      },
      "plain": {
        "zh": "监听同一事件的插件可能包装、修改或截断后续调用。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch11.b-opening"
      ]
    },
    "deepseek-ch12": {
      "question": {
        "zh": "同一宿主里的任务怎样各用各的能力？"
      },
      "deliverable": {
        "zh": "区分局部注册、服务域和清理所有权。"
      },
      "boundary": {
        "zh": "两个真实 Agent 的完整并发路径未实跑。"
      },
      "plain": {
        "zh": "作用域决定能力对谁可见，也决定谁结束时撤销注册。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch12.b-opening"
      ]
    },
    "deepseek-ch13": {
      "question": {
        "zh": "恢复会不会再次执行已完成操作？"
      },
      "deliverable": {
        "zh": "区分历史重建、缓存与副作用恢复。"
      },
      "boundary": {
        "zh": "不能从会话重放推断外部操作回滚。"
      },
      "plain": {
        "zh": "恢复需要分别处理消息、运行状态和已经发生的外部副作用。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch13.b-opening"
      ]
    },
    "deepseek-ch14": {
      "question": {
        "zh": "断线重连如何避免漏读和重复显示？"
      },
      "deliverable": {
        "zh": "区分实时事件、持久历史与远程呈现。"
      },
      "boundary": {
        "zh": "浏览器重连和远端审批未实跑。"
      },
      "plain": {
        "zh": "实时流和持久历史不是同一份数据，重连时需要重新对齐。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch14.b-opening"
      ]
    },
    "deepseek-ch15": {
      "question": {
        "zh": "工具审批能限制插件自身代码吗？"
      },
      "deliverable": {
        "zh": "划分宿主、工具、凭据和操作系统边界。"
      },
      "boundary": {
        "zh": "不宣称当前环境已有操作系统隔离。"
      },
      "plain": {
        "zh": "审批工具调用，并不自动限制加载插件的 JavaScript。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch15.b-opening"
      ]
    },
