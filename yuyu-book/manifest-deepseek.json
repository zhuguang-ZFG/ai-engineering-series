      },
      "deliverable": {
        "zh": "理解入口、版本、配置与卸载责任。"
      },
      "boundary": {
        "zh": "没有执行 npm 对外发布。"
      },
      "plain": {
        "zh": "可交付的插件包还要说明入口、版本、配置和清理契约。"
      },
      "sources": [
