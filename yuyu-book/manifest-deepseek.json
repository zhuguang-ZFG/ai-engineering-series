      "boundary": {
        "zh": "完整审查 Harness 是集成设计。"
      },
      "plain": {
        "zh": "让审查助手的每项能力都有来源、状态和停止方式。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
