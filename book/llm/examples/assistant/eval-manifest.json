{
  "schema": "assistant-eval/1",
  "description": "修改评测集前先复制并提升版本；evaluate 会记录本文件调用前后的 sha256。",
  "api_timeout": 15,
  "budgets": {
    "max_new_tokens": 192,
    "max_prompt_tokens": 2048,
    "max_steps": 3,
    "max_tool_calls": 2,
    "repair_attempts": 0,
    "top_k": 3,
    "min_score": 0.08,
    "chunk_chars": 480,
    "chunk_overlap": 80
  },
  "cases": [
    {
      "id": "normal-wind",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "2026 年 10 月 3 日观测站记录的风速是多少？",
      "expectStatus": "answered",
      "expectCitationDocs": ["station-log"],
      "note": "正常路径：回答必须引用值班记录原文。"
    },
    {
      "id": "no-hit-coffee",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "观测站的咖啡机保修期是多长时间？",
      "expectStatus": "insufficient-evidence",
      "note": "零命中：不调用生成模型，也不编造答案。"
    },
    {
      "id": "conflict-closing",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "冬季闭站时间到底是几点？",
      "expectStatus": "conflict",
      "note": "政策写 17:30，临时通知写 18:00；模型应报告冲突并引用两个文档。"
    },
    {
      "id": "unauthorized-reader",
      "reader": "guest",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "冬季闭站时间到底是几点？",
      "expectStatus": "unauthorized",
      "note": "访客身份没有任何文档权限，检索前即停止。"
    },
    {
      "id": "missing-source",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "外场手册第二版对电池维护有什么要求？",
      "documents": "documents-missing.json",
      "expectStatus": "missing-source",
      "note": "清单登记的 field-handbook-v2 文件不存在；在调用模型前失败。"
    },
    {
      "id": "model-missing",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "2026 年 10 月 3 日观测站记录的风速是多少？",
      "model": "no-such-model",
      "expectStatus": "model-unavailable",
      "note": "显式指向不存在的本地模型目录，不使用任何备用模型或预置答案。"
    },
    {
      "id": "api-unconfigured",
      "reader": "student",
      "mode": "fixed",
      "retriever": "keyword",
      "question": "2026 年 10 月 3 日观测站记录的风速是多少？",
      "provider": "api",
      "expectStatus": "api-config-missing",
      "note": "没有 ASSISTANT_API_BASE/MODEL 时，显式 API 提供方应报配置缺失，且不发起网络请求。"
    },
    {
      "id": "agent-calculator",
      "reader": "student",
      "mode": "agent",
      "retriever": "keyword",
      "question": "值班记录里 2026-10-03 的风速是 4.2 米每秒。如果连续 24 小时都保持这个风速，总行程是多少米？请用 calculator 计算 4.2*86400。",
      "allowed_tools": ["calculator"],
      "expectStatus": "answered",
      "expectTool": "calculator",
      "note": "模型自选工具的有界循环；工具回执必须作为 claim 的引用。"
    }
  ]
}
